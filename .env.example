# ─────────────────────────────────────────────────
# Dhan API credentials (required)
# Obtain from https://dhan.co/
# ─────────────────────────────────────────────────
DHAN_CLIENT_ID=your_client_id_here
DHAN_ACCESS_TOKEN=your_access_token_here

# ─────────────────────────────────────────────────
# Backtest settings (all optional – defaults shown)
# ─────────────────────────────────────────────────

# Stock symbol to backtest (NSE equity symbol)
SYMBOL=RELIANCE

# Number of historical calendar days to include
BACKTEST_DAYS=365

# Starting capital in INR
INITIAL_CAPITAL=100000

# Commission per trade as a decimal (0.001 = 0.1 %)
COMMISSION=0.001

# Strategy to use: MA_CROSSOVER | INSIDE_CANDLE_RSI | INSIDE_CANDLE_RSI_AGGRESSIVE
STRATEGY_TYPE=MA_CROSSOVER
STRATEGY_NAME=MA_CROSSOVER

# ─────────────────────────────────────────────────
# MA Crossover strategy parameters
# ─────────────────────────────────────────────────
SHORT_MA_PERIOD=20
LONG_MA_PERIOD=50
MA_WARMUP_PERIOD=15

# ─────────────────────────────────────────────────
# Inside Candle RSI strategy parameters
# ─────────────────────────────────────────────────
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
IC_WARMUP_PERIOD=20

# Risk management (leave blank to disable)
STOP_LOSS_PCT=2.0
TAKE_PROFIT_PCT=4.0
TRAILING_STOP_PCT=1.5
# MAX_BARS=

# ─────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ─────────────────────────────────────────────────
# API server (only needed when running the web API)
# ─────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
